{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "med4one-we",
  "compatibility_date": "2026-09-11",
  "main": "./dist/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "observability": {
    "enabled": true
  }
}